# Copy to /etc/sps-desk/provider.env (root:root, mode 0600).
# Set true only after confirming that the site's public delivery is licensed.
SPS_MASSIVE_PUBLIC_APPROVED=false
SPS_XSP_STATE_PATH=/var/lib/sps-desk/xsp-selection.json
# Set true separately only if the license covers VIX history display.
SPS_PUBLIC_HISTORY_APPROVED=false
# Put the key alone in /etc/sps-desk/massive-api-key, not in this file.
